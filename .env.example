# Optional shell environment; .env files are not automatically read.
# Export values, or: set -a; . ./.env; set +a
# LLAMA_SERVER_PATH=/absolute/path/to/llama-server
# LLAMA_MODEL_PATH=/absolute/path/to/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLAMA_THREADS=4
LLAMA_CTX_SIZE=4096
LLAMA_MAX_TOKENS=1024
LLAMA_PORT=8081

# Optional backend settings; export before python -m backend.
# LLAMA_API_UPSTREAM_URL=http://127.0.0.1:8081
# LLAMA_API_CONNECT_TIMEOUT=5
# LLAMA_API_READ_TIMEOUT=30
# LLAMA_API_TOTAL_TIMEOUT=120

# Phase 3: replace with a private local role/password. Never commit real credentials.
# LLAMA_DATABASE_URL=postgresql+psycopg://llama_app:CHANGE_ME@127.0.0.1:5432/llama
# A separate disposable database whose name ends in _test is required for DB tests.
# LLAMA_TEST_DATABASE_URL=postgresql+psycopg://llama_test:CHANGE_ME@127.0.0.1:5432/llama_test
# false for local HTTP; true requires HTTPS (Phase 4).
# LLAMA_SESSION_COOKIE_SECURE=false

# Phase 4 public profile is opt-in. Deployment remains a separate manual action.
# LLAMA_PUBLIC_ORIGIN=https://YOUR_DOMAIN
# Public mode requires LLAMA_DATABASE_URL and LLAMA_SESSION_COOKIE_SECURE=true.
# LLAMA_IP_REQUESTS_PER_MINUTE=60
# LLAMA_SESSION_REQUESTS_PER_MINUTE=6
# LLAMA_DAILY_SESSION_REQUESTS=50
# LLAMA_DAILY_SESSION_TOKENS=32768
# LLAMA_DAILY_IP_REQUESTS=200
# LLAMA_DAILY_IP_TOKENS=131072
# LLAMA_QUEUE_SIZE=2
# LLAMA_QUEUE_WAIT_TIMEOUT=10
