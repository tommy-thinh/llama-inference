# Optional shell environment; .env files are not automatically read.
# Export values, or: set -a; . ./.env; set +a
# LLAMA_SERVER_PATH=/absolute/path/to/llama-server
# LLAMA_MODEL_PATH=/absolute/path/to/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLAMA_THREADS=4
LLAMA_CTX_SIZE=4096
LLAMA_MAX_TOKENS=1024
LLAMA_PORT=8081

# Optional backend settings; export before python -m backend.
# LLAMA_API_UPSTREAM_URL=http://127.0.0.1:8081
# LLAMA_API_CONNECT_TIMEOUT=5
# LLAMA_API_READ_TIMEOUT=30
# LLAMA_API_TOTAL_TIMEOUT=120
