[Unit]
Description=Single-worker Llama API (loopback)
Wants=llama-inference.service
After=network.target postgresql.service llama-inference.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=llamaapp
Group=llamaapp
WorkingDirectory=/opt/llama/app
EnvironmentFile=/etc/llama/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/llama/env/bin/python -m backend --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
