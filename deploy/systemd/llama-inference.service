[Unit]
Description=Pinned CPU-only Llama inference (loopback)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=llamainfer
Group=llamainfer
WorkingDirectory=/opt/llama/app
EnvironmentFile=/etc/llama/inference.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=GIT_CONFIG_GLOBAL=/dev/null
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=/opt/llama/app/.runtime/llama.cpp
ExecStart=/opt/llama/env/bin/python -m inference.server
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=0
CPUQuota=300%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
