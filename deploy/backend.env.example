# systemd EnvironmentFile syntax: no export, no shell expansion.
# Real file: /etc/llama/backend.env, root:llamaapp, mode 0640.
LLAMA_PUBLIC_ORIGIN=https://YOUR_DOMAIN
LLAMA_SESSION_COOKIE_SECURE=true
LLAMA_DATABASE_URL=postgresql+psycopg://llama_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/llama
LLAMA_API_UPSTREAM_URL=http://127.0.0.1:8081
LLAMA_API_CONNECT_TIMEOUT=5
LLAMA_API_READ_TIMEOUT=30
LLAMA_API_TOTAL_TIMEOUT=120
